<?xml version="1.0" encoding="UTF-8"?>
<?xml-stylesheet type="text/xsl" href="configuration.xsl"?>
<configuration>
  <!-- Nodo único: NameNode y DataNode en el mismo host -->
  <property>
    <name>dfs.replication</name>
    <value>1</value>
  </property>

  <property>
    <name>dfs.namenode.name.dir</name>
    <value>file:///opt/hadoop/data/nameNode</value>
  </property>

  <property>
    <name>dfs.datanode.data.dir</name>
    <value>file:///opt/hadoop/data/dataNode</value>
  </property>

  <!-- Permite acceso sin Kerberos en entorno de desarrollo -->
  <property>
    <name>dfs.permissions.enabled</name>
    <value>false</value>
  </property>

  <!-- WebHDFS para integración con n8n y notebooks -->
  <property>
    <name>dfs.webhdfs.enabled</name>
    <value>true</value>
  </property>

  <!-- Dirección del NameNode Web UI -->
  <property>
    <name>dfs.namenode.http-address</name>
    <value>0.0.0.0:9870</value>
  </property>

  <!-- CRÍTICO para Docker: el DataNode anuncia su hostname (no su IP interna)
       así los clientes externos (ml-env, Spark) pueden conectar correctamente -->
  <property>
    <name>dfs.datanode.hostname</name>
    <value>hadoop</value>
  </property>

  <property>
    <name>dfs.client.use.datanode.hostname</name>
    <value>true</value>
  </property>

</configuration>
