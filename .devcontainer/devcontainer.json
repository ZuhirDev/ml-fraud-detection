{
    "name": "ML Fraud Detection Dev Environment",
    "dockerComposeFile": "../infrastructure/ml-env/docker-compose.yml",
    "service": "ml-env",
    "workspaceFolder": "/app",
    "customizations": {
        "vscode": {
            "extensions": [
                "ms-python.python",
                "ms-toolsai.jupyter",
                "ms-python.vscode-pylint",
                "ms-azuretools.vscode-docker",
                "ms-python.vscode-pylance",
                "ms-toolsai.jupyter-keymap",
                "ms-toolsai.jupyter-renderers"
            ],
            "settings": {
                "python.defaultInterpreterPath": "/usr/local/bin/python",
                "python.analysis.extraPaths": ["/app", "/app/src"],
                "python.linting.enabled": true,
                "python.linting.pylintEnabled": true,
                "jupyter.notebookFileRoot": "/app/notebooks"
            }
        }
    },
    "forwardPorts": [8888],
    "remoteUser": "root"
}